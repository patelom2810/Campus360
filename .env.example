# Database Engine Selection (postgres | sqlite)
DB_ENGINE=postgres

# PostgreSQL Configuration
POSTGRES_USER=campus360
POSTGRES_PASSWORD=changeme
POSTGRES_DB=campus360_warehouse
POSTGRES_HOST=localhost

# Port when accessing from host machine (Docker forwards host 5433 -> container 5432)
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# Full Database URL
DATABASE_URL=postgresql://campus360:changeme@localhost:5433/campus360_warehouse

# Inside Docker Compose:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://campus360:changeme@postgres:5432/campus360_warehouse

# API & Dashboard Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# LLM / GenAI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
